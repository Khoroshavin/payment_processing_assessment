# Application
# ENV selects the logging config: "production"/"staging" -> JSON logs,
# anything else ("dev"/"test") -> console logs
ENV=dev
LOG_LEVEL=INFO
# Цветные консольные логи (dev): always — цвета даже в docker compose logs,
# never — отключить, auto — только в терминале
LOG_COLORS=always

# API server bind address and port
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security: static API key for the X-API-Key header.
# Mandatory override in production: with ENV=production|staging the service
# refuses to start on the insecure default.
API_KEY=dev-secret-change-me

# PostgreSQL ("localhost" for non-docker runs; compose overrides host to "postgres")
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments

# RabbitMQ ("localhost" for non-docker runs; compose overrides host to "rabbitmq")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# RabbitMQ topology
RABBITMQ_EXCHANGE_NAME=payments
RABBITMQ_QUEUE_NAME=payments.new
RABBITMQ_DLX_NAME=payments.dlx
RABBITMQ_DLQ_NAME=payments.new.dlq
RABBITMQ_DLQ_ROUTING_KEY=payments.new

# Webhook delivery
WEBHOOK_TIMEOUT_SECONDS=5

# Payment gateway emulation (2-5s, 90% success)
EMULATION_MIN_DELAY_SECONDS=2
EMULATION_MAX_DELAY_SECONDS=5
EMULATION_SUCCESS_RATE=0.9

# Outbox relay
RELAY_POLL_INTERVAL_SECONDS=0.5
RELAY_BATCH_SIZE=100
# Порог эскалации логов (ERROR для алертинга). Retry публикации не
# прекращается никогда: события outbox гарантированно доставляются.
RELAY_MAX_ATTEMPTS=10
RELAY_BACKOFF_BASE_SECONDS=1
RELAY_BACKOFF_CAP_SECONDS=60

# Consumer retries: 3 attempts total (1 initial + 2 retries)
CONSUMER_MAX_RETRIES=2
CONSUMER_RETRY_DELAYS_SECONDS=[2,4]

# Host-side published ports (compose only)
RABBITMQ_UI_PORT=15672
